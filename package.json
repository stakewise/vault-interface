{
  "name": "vault-interface",
  "license": "MIT",
  "version": "1.1.1",
  "description": "Vault Interface",
  "homepage": ".",
  "private": true,
  "scripts": {
    "fast": "next dev -p 5005",
    "build": "npm run typechain && npm run colors && next build",
    "dev": "npm run check:env && npm run typechain && npm run colors && npm run fast",
    "lint": "next lint",
    "lint:css": "stylelint **/*.scss",
    "lint:css:fix": "stylelint **/*.scss --fix",
    "colors": "node ./scripts/generateColors",
    "check:env": "node ./scripts/checkLocalEnv.js",
    "typechain": "typechain --target ethers-v6 --out-dir src/helpers/contracts/types 'src/helpers/contracts/abis/*.json'",
    "e2e": "npx playwright test",
    "e2e:docker": "./scripts/fork-docker.sh",
    "e2e:headed": "npx playwright test --ui --headed",
    "e2e:dev": "concurrently --kill-others \"npm run e2e:headed\" \"npm run e2e:docker\" \"npm run dev\"",
    "prepare:playwright": "npm i -g playwright",
    "prepare": "husky"
  },
  "engines": {
    "node": "=22.14.0",
    "npm": "=10.9.2"
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "@playwright/test": "1.52.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@guardianui/test": "1.0.4",
    "@playwright/test": "1.52.0",
    "@typechain/ethers-v6": "0.5.1",
    "@types/js-cookie": "3.0.6",
    "@types/node": "22.15.21",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "@types/ua-parser-js": "0.7.39",
    "concurrently": "9.1.2",
    "css-class-generator": "2.0.0",
    "dotenv": "16.5.0",
    "eslint": "9.27.0",
    "eslint-config-next": "15.3.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-react": "7.37.5",
    "file-loader": "6.2.0",
    "sass": "1.89.0",
    "sass-loader": "16.0.5",
    "stylelint": "16.19.1",
    "stylelint-config-rational-order": "0.1.2",
    "stylelint-scss": "6.12.0",
    "tailwindcss": "4.1.7",
    "terser-webpack-plugin": "5.3.14",
    "typechain": "8.3.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.33.0"
  },
  "dependencies": {
    "@binance/w3w-ethereum-provider": "1.1.8-alpha.0",
    "@cowprotocol/cow-sdk": "5.10.3",
    "@headlessui/react": "2.2.4",
    "@ledgerhq/hw-app-eth": "6.45.5",
    "@ledgerhq/hw-transport-web-ble": "6.29.12",
    "@ledgerhq/hw-transport-webhid": "6.30.1",
    "@ledgerhq/hw-transport-webusb": "6.29.5",
    "@metamask/onboarding": "1.0.1",
    "@reduxjs/toolkit": "2.8.2",
    "@stakewise/v3-sdk": "4.2.1",
    "@tailwindcss/postcss": "4.1.7",
    "@types/react-redux": "7.1.34",
    "@wagmi/connectors": "5.8.3",
    "async-mutex": "0.5.0",
    "autoprefixer": "10.4.21",
    "circular-dependency-plugin": "5.2.2",
    "classnames": "2.5.1",
    "dayjs": "1.11.13",
    "destyle.css": "4.0.1",
    "ethers": "6.14.3",
    "ethers-5": "npm:ethers@5.0.0",
    "focus-visible": "5.2.1",
    "husky": "9.1.7",
    "js-cookie": "3.0.5",
    "lightweight-charts": "5.0.7",
    "next": "15.3.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-redux": "9.2.0",
    "swiper": "11.2.8",
    "ua-parser-js": "2.0.3",
    "viem": "2.30.1",
    "xlsx": "0.18.5"
  }
}
