{
  "name": "vault-interface",
  "version": "1.0.1",
  "description": "Vault Interface",
  "homepage": ".",
  "private": true,
  "scripts": {
    "fast": "next dev -p 5005",
    "build": "npm run typechain && npm run colors && next build",
    "dev": "npm run check:env && npm run typechain && npm run colors && npm run fast",
    "lint": "next lint",
    "lint:css": "stylelint **/*.scss",
    "colors": "node ./scripts/generateColors",
    "lint:css:fix": "stylelint **/*.scss --fix",
    "check:env": "node ./scripts/checkLocalEnv.js",
    "typechain": "typechain --target ethers-v6 --out-dir src/helpers/contracts/types 'src/helpers/contracts/abis/*.json'",
    "prepare": "husky"
  },
  "engines": {
    "node": "=20.12.2",
    "npm": "=10.5.0"
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "license": "MIT",
  "devDependencies": {
    "@typechain/ethers-v6": "0.5.1",
    "@types/js-cookie": "3.0.6",
    "@types/node": "22.15.3",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.2",
    "@types/ua-parser-js": "0.7.39",
    "css-class-generator": "2.0.0",
    "eslint": "9.24.0",
    "eslint-config-next": "15.3.0",
    "eslint-plugin-import": "2.31.0",
    "file-loader": "6.2.0",
    "sass": "1.86.3",
    "sass-loader": "16.0.5",
    "stylelint": "16.8.1",
    "stylelint-config-rational-order": "0.1.2",
    "stylelint-scss": "6.5.0",
    "tailwindcss": "4.1.3",
    "terser-webpack-plugin": "5.3.11",
    "typechain": "8.3.2",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@headlessui/react": "2.2.1",
    "@ledgerhq/hw-app-eth": "6.38.0",
    "@ledgerhq/hw-transport-webhid": "6.29.2",
    "@ledgerhq/hw-transport-webusb": "6.29.2",
    "@metamask/onboarding": "1.0.1",
    "@reduxjs/toolkit": "2.6.1",
    "@stakewise/v3-sdk": "3.5.0",
    "@tailwindcss/postcss": "4.1.3",
    "@types/react-redux": "7.1.34",
    "@wagmi/connectors": "5.1.10",
    "async-mutex": "0.5.0",
    "autoprefixer": "10.4.20",
    "circular-dependency-plugin": "5.2.2",
    "classnames": "2.5.1",
    "dayjs": "1.11.12",
    "destyle.css": "4.0.1",
    "ethers": "6.13.2",
    "focus-visible": "5.2.1",
    "husky": "^9.1.7",
    "js-cookie": "3.0.5",
    "lightweight-charts": "4.2.0",
    "next": "15.3.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-redux": "9.2.0",
    "swiper": "11.1.15",
    "ua-parser-js": "1.0.38",
    "viem": "2.25.0",
    "xlsx": "0.18.5"
  }
}
