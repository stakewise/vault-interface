{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "rootDir": ".",
    "allowJs": true,
    "outDir": "dist",
    "sourceMap": true,
    "target": "esnext",
    "module": "esnext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "*": [
        "./src/*"
      ],
      "scripts/*": [
        "./scripts/*"
      ],
      "sdk": [
        "./node_modules/@stakewise/v3-sdk"
      ]
    },
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "src/**/*.ts",
    "e2e/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "e2e/**/*.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
